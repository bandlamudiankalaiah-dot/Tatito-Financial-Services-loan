# ==============================================================================
# TATITO FINANCIAL SERVICES — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local production or development execution
# ==============================================================================

# Server Runtime
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"

# JWT Authentication
JWT_SECRET="tatito-kadapa-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# Security & CORS
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# Storage Mode: In development, set to "demo" to permit fallback file persistence.
# In production, PostgreSQL (DATABASE_URL) is the required single source of truth.
DATA_STORE_MODE="demo"

# PostgreSQL Database Configuration
# Connect via standard PostgreSQL connection string or individual parameters:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tatito_finance"
PGHOST="localhost"
PGPORT=5432
PGUSER="postgres"
PGPASSWORD="postgres_secure_password"
PGDATABASE="tatito_finance"

# Financial Partner Integration Gateways (Sandbox / Production)
# If left blank, the application automatically uses official mock adapters with DEMO labels.
KYC_PROVIDER_API_KEY=""
KYC_PROVIDER_URL="https://sandbox.digitalkyc.gov.in/api/v2"

CREDIT_BUREAU_MEMBER_ID=""
CREDIT_BUREAU_SECRET=""

ESIGN_PROVIDER_SECRET=""
ESIGN_GATEWAY_URL="https://esign-sandbox.tatito.in"

MANDATE_API_KEY=""
MANDATE_SECRET=""

PAYMENT_GATEWAY_KEY=""
PAYMENT_GATEWAY_SECRET=""

CO_LENDING_PARTNER_API_KEY=""
NSDL_DP_GATEWAY_KEY=""
BSE_STAR_MF_PASSWORD=""
